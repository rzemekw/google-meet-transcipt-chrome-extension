{
  "manifest_version": 3,
  "name": "Meet Transcript to File",
  "version": "0.1.0",
  "description": "Turns on Google Meet captions and appends every caption line (time, speaker, text) to a text file on disk.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
